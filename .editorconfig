root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,c,cpp,cc,h,hpp,rs,go}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{toml,yml,yaml,json,jsonc,sh,zsh,bash}]
indent_size = 2

# Preserve imported files byte-for-byte. See THIRD_PARTY.md and upstream/lock.json.

[skills/impeccable/SCREENSHOT-LICENSE]
insert_final_newline = false

[skills/impeccable/UPSTREAM.md]
insert_final_newline = false

[skills/impeccable/agents/openai.yaml]
insert_final_newline = false

[skills/impeccable/reference/degraded/asset-producer.md]
insert_final_newline = false

[skills/impeccable/reference/degraded/documenter.md]
insert_final_newline = false

[skills/impeccable/reference/degraded/finish-reviewer.md]
insert_final_newline = false

[skills/impeccable/reference/degraded/manual-edit-applier.md]
