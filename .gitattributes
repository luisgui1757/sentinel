* text=auto

# Keep LF on each platform, so a Windows checkout gives the same bytes and the
# installers write the same files.
*.md      text eol=lf
*.json    text eol=lf
*.mjs     text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
tools/*   text eol=lf
LICENSE   text eol=lf
Makefile  text eol=lf

# Imported skills keep the upstream bytes. upstream/lock.json pins them.
skills/** -text
skills/impeccable/reference/extract.md whitespace=-blank-at-eof
skills/impeccable/reference/harden.md whitespace=-blank-at-eof,-blank-at-eol
skills/impeccable/reference/optimize.md whitespace=-blank-at-eof,-blank-at-eol
