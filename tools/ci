#!/usr/bin/env bash
# Sentinel local preflight gate, runnable on your machine.
#
# Runs the privacy leak scan, render smoke test, adapter drift check, semantic
# ruleset check, lint, and ShellCheck. GitHub's required `ci` aggregate is
# stronger: it adds OS matrix tests, strict lint, and native Windows proof.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

echo "sentinel ci: core + whole-tree leak check"
bash "$SCRIPT_DIR/check"

echo "sentinel ci: render smoke"
bash "$SCRIPT_DIR/render" > /dev/null

echo "sentinel ci: adapter drift check"
bash "$SCRIPT_DIR/install" --check

echo "sentinel ci: ruleset semantics"
bash "$SCRIPT_DIR/ruleset-check"

echo "sentinel ci: repository policy"
bash "$SCRIPT_DIR/repository-policy-check"

echo "sentinel ci: upstream import drift"
node "$SCRIPT_DIR/upstream.mjs" --check

echo "sentinel ci: lint (yaml + editorconfig + secrets + schema)"
bash "$SCRIPT_DIR/lint"

echo "sentinel ci: shellcheck (shell tooling correctness)"
if command -v shellcheck >/dev/null 2>&1; then
  bash "$SCRIPT_DIR/lint-shell"
elif [[ "${SENTINEL_STRICT:-0}" == 1 ]]; then
  echo "sentinel ci: FAIL: shellcheck is required in strict mode but is not installed." >&2
  exit 1
else
  echo "sentinel ci: shellcheck not installed; SKIPPING (set SENTINEL_STRICT=1 to require it)" >&2
fi

echo "sentinel ci: passed."
