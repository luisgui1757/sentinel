#!/usr/bin/env bash
# Sentinel status -- where the rules are installed and whether they are current.
#
# For each entrypoint (repo-local and per-user/global): is it present, does it
# carry the managed block, and does that block match the CURRENTLY rendered
# bundle (current / STALE / MALFORMED / no-block / absent / overridden)? Plus
# which CLI binaries are on PATH. Read-only. Usage: tools/status [--target DIR]
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
# shellcheck source=sentinel-lib.sh
source "$SCRIPT_DIR/sentinel-lib.sh"
MANIFEST="$REPO_ROOT/MANIFEST.json"
CORE="$REPO_ROOT/$(sentinel_manifest_core_dir "$MANIFEST")"
METADATA="$REPO_ROOT/templates/adapters/tool-metadata.tsv"

TARGET_DIR="$REPO_ROOT"
case "${1:-}" in
  --target) TARGET_DIR=$(cd "${2:?--target needs a directory}" 2>/dev/null && pwd) || { echo "status: --target directory not found: ${2:-}" >&2; exit 2; } ;;
  --target=*) TARGET_DIR=$(cd "${1#--target=}" 2>/dev/null && pwd) || { echo "status: --target directory not found: ${1#--target=}" >&2; exit 2; } ;;
esac

ver=$(tr -d ' \r\n' < "$REPO_ROOT/VERSION" 2>/dev/null || echo dev)
sha=$(sentinel_bundle_sha256 "$CORE" "$MANIFEST")
blockfile=$(mktemp)
sentinel_render_managed_block "$CORE" "$MANIFEST" "$REPO_ROOT/VERSION" > "$blockfile"
trap 'rm -f "$blockfile"' EXIT

state_of() {
  local path=$1 out state
  if [[ ! -e "$path" ]]; then printf 'absent'; return; fi
  if ! grep -q '^<!-- AGENT-RULES:BEGIN' "$path" 2>/dev/null; then printf 'no-block'; return; fi
  out=$(mktemp)
  if sentinel_compose_adapter "$path" "$blockfile" "$out"; then
    if cmp -s "$path" "$out"; then state=current; else state=STALE; fi
  else
    state=MALFORMED
  fi
  rm -f "$out"
  printf '%s' "$state"
}
read_metadata() {
  [[ -f "$METADATA" ]] || { echo "status: missing adapter metadata: $METADATA" >&2; exit 1; }
  awk -F '\t' 'NF && $1 !~ /^#/ { print }' "$METADATA"
}

metadata_label() {
  local scope=$1 key=$2 labels=() joined="" label
  local _slug display _binary repo_entrypoint global_entrypoint _imports _install_scope _evidence_status _evidence_date _evidence_source
  while IFS=$'\t' read -r _slug display _binary repo_entrypoint global_entrypoint _imports _install_scope _evidence_status _evidence_date _evidence_source; do
    case "$scope" in
      repo) [[ "$repo_entrypoint" == "$key" ]] && labels+=("$display") ;;
      global) [[ "$global_entrypoint" == "$key" ]] && labels+=("$display") ;;
    esac
  done < <(read_metadata)
  for label in ${labels[@]+"${labels[@]}"}; do
    if [[ -n "$joined" ]]; then joined="$joined, $label"; else joined=$label; fi
  done
  printf '%s' "$joined"
}

global_entrypoint_key_for_path() {
  local path=$1 tilde="~"
  case "$path" in
    "${CODEX_HOME:-$HOME/.codex}/AGENTS.md") printf '%s\n' "\${CODEX_HOME:-$tilde/.codex}/AGENTS.md" ;;
    "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md") printf '%s\n' "\${CLAUDE_CONFIG_DIR:-$tilde/.claude}/CLAUDE.md" ;;
    "$HOME/.copilot/copilot-instructions.md") printf '%s\n' "$tilde/.copilot/copilot-instructions.md" ;;
    "$HOME/.kiro/steering/AGENTS.md") printf '%s\n' "$tilde/.kiro/steering/AGENTS.md" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

row() {
  local path=$1 label=${2:-} state=${3:-} display_path tilde="~"
  [[ -n "$state" ]] || state=$(state_of "$path")
  display_path=$path
  case "$path" in
    "$HOME"/*) display_path="$tilde/${path#"$HOME/"}" ;;
    "$HOME") display_path=$tilde ;;
  esac
  if [[ -n "$label" ]]; then
    printf '  %-10s %-58s %s\n' "$state" "$display_path" "$label"
  else
    printf '  %-10s %s\n' "$state" "$display_path"
  fi
}

repo_row() {
  local target=$1 rel
  rel=${target#"$TARGET_DIR"/}
  row "$target" "$(metadata_label repo "$rel")"
}

global_row() {
  local target=$1 key label state="" codex_agents codex_override
  key=$(global_entrypoint_key_for_path "$target")
  label=$(metadata_label global "$key")
  codex_agents="${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
  codex_override="${CODEX_HOME:-$HOME/.codex}/AGENTS.override.md"
  if [[ "$target" == "$codex_agents" && -f "$codex_override" ]]; then
    state=overridden
    label="$label (AGENTS.override.md takes precedence)"
  fi
  row "$target" "$label" "$state"
}

cli_binaries() {
  local _slug _display binary _repo_entrypoint _global_entrypoint _imports _install_scope _evidence_status _evidence_date _evidence_source
  while IFS=$'\t' read -r _slug _display binary _repo_entrypoint _global_entrypoint _imports _install_scope _evidence_status _evidence_date _evidence_source; do
    [[ -n "$binary" && "$binary" != "-" ]] || continue
    if command -v "$binary" >/dev/null 2>&1; then printf ' %s=yes' "$binary"; else printf ' %s=no' "$binary"; fi
  done < <(read_metadata)
}

echo "sentinel status -- v$ver, current bundle ${sha:0:12}"
echo
echo "repo ($TARGET_DIR):"
while IFS= read -r t; do repo_row "$t"; done < <(sentinel_repo_adapter_targets "$TARGET_DIR")
echo
echo "global (per-user):"
while IFS= read -r t; do global_row "$t"; done < <(sentinel_global_adapter_targets "codex,claude,copilot,kiro")
echo
printf 'CLI binaries on PATH:'
cli_binaries
echo
