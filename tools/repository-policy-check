#!/usr/bin/env bash
# Verifies repository-level policy that is not represented by the core bundle.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=${SENTINEL_REPO_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}
[[ "$REPO_ROOT" == /* ]] || {
  echo "repository-policy-check: FAIL: repository root must be absolute." >&2
  exit 2
}
cd "$REPO_ROOT"

failures=0
fail() {
  echo "repository-policy-check: FAIL: $*" >&2
  failures=1
}

if ! command -v jq >/dev/null 2>&1; then
  echo "repository-policy-check: FAIL: jq is required." >&2
  exit 1
fi

if [[ -f .github/dependabot.yml || -f .github/dependabot.yaml ]]; then
  fail "version updates must have one owner; remove Dependabot version-update configuration"
fi

if grep -Eq '^branches:[[:space:]]*$' .github/settings.yml; then
  fail ".github/settings.yml must not duplicate rulesets with classic branch protection"
fi

if ! grep -Eq '^permissions:[[:space:]]*$' .github/workflows/ci.yml \
  || ! grep -Eq '^[[:space:]]+contents:[[:space:]]+read([[:space:]]|$)' .github/workflows/ci.yml; then
  fail "CI must declare read-only contents permission"
fi

if [[ ! -f .github/ci-requirements.in || ! -f .github/ci-requirements.txt ]]; then
  fail "hash-locked CI Python requirements source and artifact are required"
elif ! grep -Fq -- '--require-hashes' .github/workflows/ci.yml \
  || ! grep -Fq -- '--hash=sha256:' .github/ci-requirements.txt \
  || ! grep -Fq 'uv pip compile' .github/ci-requirements.txt; then
  fail "CI Python tools must install from the generated SHA-256 lock"
fi
# The sole write exception is JSON (valid YAML), so jq can verify its complete
# permission structure without a permissive text match or another YAML runtime.
bot=.github/workflows/upstream-imports.yml
if [[ -f "$bot" ]]; then
  if ! jq -e '
    .permissions == {contents: "read"}
    and (.on | keys | sort) == ["schedule", "workflow_dispatch"]
    and (.jobs | keys) == ["propose"]
    and .jobs.propose.permissions == {contents: "write", "pull-requests": "write"}
    and .jobs.propose.if == "github.ref == '\''refs/heads/main'\''"
    and .jobs.propose.steps[0].with.ref == "main"
    and .jobs.propose.steps[0].with["persist-credentials"] == false
    and ([.. | objects | .uses? // empty] | all(test("^actions/[a-z-]+@[0-9a-f]{40}$")))
  ' "$bot" >/dev/null; then
    fail "upstream bot must keep its main-only, narrowly scoped write permissions"
  fi
fi
while IFS= read -r workflow; do
  [[ "$workflow" == "$bot" ]] && continue
  if [[ "$workflow" != .github/workflows/ci.yml ]]; then
    fail "workflow is outside the reviewed allowlist: $workflow"
    continue
  fi
  if grep -Eq "[\"']?[a-z-]+[\"']?[[:space:]]*:[[:space:]]*[\"']?write(-all)?" "$workflow"; then
    fail "workflow permissions must not grant write access outside the upstream bot"
  fi
done < <(find .github/workflows -type f)

while IFS= read -r use; do
  use=${use%%#*}
  use=${use#*uses:}
  use=${use//[\"\']/}
  use=$(printf '%s' "$use" | tr -d '[:space:]')
  [[ -z "$use" || "$use" == ./* ]] && continue
  if [[ "$use" != actions/*@* ]]; then
    fail "workflow dependency is outside the selected GitHub-owned actions policy: $use"
    continue
  fi
  ref=${use##*@}
  if [[ ! "$ref" =~ ^[0-9a-f]{40}$ ]]; then
    fail "workflow action is not pinned to a full lowercase commit SHA: $use"
  fi
done < <(grep -hE '^[[:space:]-]*uses:[[:space:]]*' .github/workflows/*.yml .github/workflows/*.yaml 2>/dev/null || true)

if [[ ! -f renovate.json ]]; then
  fail "renovate.json is required as the single version-update policy"
else
  if ! jq -e '
    .automerge == false
    and .vulnerabilityAlerts.enabled == false
    and (.enabledManagers | sort) == (["custom.regex", "github-actions", "pip-compile"] | sort)
    and (.extends | index("helpers:pinGitHubActionDigests")) != null
    and .lockFileMaintenance.enabled == true
    and (."pip-compile".managerFilePatterns | index("/^\\.github/ci-requirements\\.txt$/")) != null
    and ([.customManagers[].depNameTemplate] | sort)
      == (["editorconfig-checker/editorconfig-checker", "gitleaks/gitleaks"] | sort)
    and ([.customManagers[].matchStrings[]] | any(test("ec_ver=")))
    and ([.customManagers[].matchStrings[]] | any(test("gl_ver=")))
  ' renovate.json >/dev/null; then
    fail "renovate.json must cover every executable pin, keep automerge off, and defer vulnerability updates to GitHub"
  fi
fi

if [[ "$failures" -ne 0 ]]; then
  exit 1
fi

echo "repository-policy-check: ok: repository governance sources are canonical and fail closed."
