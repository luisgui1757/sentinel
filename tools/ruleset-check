#!/usr/bin/env bash
# Semantic verifier for Sentinel's checked-in and live GitHub governance.
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
RULESET_DIR="$REPO_ROOT/.github/rulesets"
OWNER_ID=""
LIVE_REPO=""

usage() {
  cat <<'EOF'
ruleset-check [--ruleset-dir DIR] [--owner-id ID]
ruleset-check --repo owner/repo [--owner-id ID]

Verifies Sentinel's main-branch contract:
  - integrity has no bypass and requires PRs, strict GitHub Actions `ci`, CodeQL,
    linear history, and deletion/non-fast-forward protection
  - review and owner-update rules allow only the repository owner to bypass,
    and only while merging a pull request
  - live mode additionally verifies the repository, Actions, security, CodeQL,
    immutable-release, and single-source ruleset posture
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ruleset-dir) shift; RULESET_DIR=${1:?--ruleset-dir needs a directory} ;;
    --ruleset-dir=*) RULESET_DIR=${1#--ruleset-dir=} ;;
    --owner-id) shift; OWNER_ID=${1:?--owner-id needs an id} ;;
    --owner-id=*) OWNER_ID=${1#--owner-id=} ;;
    --repo) shift; LIVE_REPO=${1:?--repo needs owner/repo} ;;
    --repo=*) LIVE_REPO=${1#--repo=} ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ruleset-check: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

command -v jq >/dev/null 2>&1 || {
  echo "ruleset-check: FAIL: jq is required." >&2
  exit 1
}
if [[ -n "$LIVE_REPO" ]]; then
  [[ "$LIVE_REPO" == */* ]] || { echo "ruleset-check: FAIL: --repo must be owner/repo." >&2; exit 2; }
  command -v gh >/dev/null 2>&1 || { echo "ruleset-check: FAIL: gh is required for --repo." >&2; exit 1; }
fi

tmp_dir=""
trap '[[ -n "$tmp_dir" ]] && rm -rf "$tmp_dir"' EXIT
failures=0
fail() { echo "ruleset-check: FAIL: $*" >&2; failures=1; }

jq_check() {
  local file=$1 desc=$2
  shift 2
  jq -e "$@" "$file" >/dev/null || fail "$(basename "$file"): $desc"
}

jq_check_value() {
  local value=$1 desc=$2 expression=$3
  printf '%s\n' "$value" | jq -e "$expression" >/dev/null || fail "$desc"
}

require_file() {
  [[ -f "$1" ]] || { fail "missing ruleset file: $1"; return 1; }
}

fetch_live_rulesets() {
  local repo=$1 list_json name file ids id
  tmp_dir=$(mktemp -d)
  RULESET_DIR="$tmp_dir"
  if [[ -z "$OWNER_ID" ]]; then
    OWNER_ID=$(gh api "repos/$repo" --jq '.owner.id' 2>/dev/null || true)
    [[ -n "$OWNER_ID" ]] || fail "could not resolve live repository owner id for $repo"
  fi
  list_json=$(gh api "repos/$repo/rulesets?includes_parents=false") || {
    fail "could not list live rulesets for $repo"
    return
  }
  while IFS='|' read -r name file; do
    ids=$(printf '%s\n' "$list_json" | jq -r --arg name "$name" '[.[] | select(.name == $name) | .id] | .[]')
    if [[ $(printf '%s\n' "$ids" | sed '/^$/d' | wc -l | tr -d ' ') != 1 ]]; then
      fail "live ruleset must exist exactly once: $name"
      continue
    fi
    id=$ids
    gh api "repos/$repo/rulesets/$id" > "$RULESET_DIR/$file" || fail "could not fetch live ruleset: $name"
  done <<'EOF'
Protect main: integrity|main-integrity.json
Protect main: review|main-review.json
Protect main: owner updates|main-owner-updates.json
EOF
}

require_common_ruleset() {
  local file=$1 expected_name=$2
  require_file "$file" || return
  jq_check "$file" "name is '$expected_name'" --arg name "$expected_name" ".name == \$name"
  jq_check "$file" "target is branch" '.target == "branch"'
  jq_check "$file" "enforcement is active" '.enforcement == "active"'
  jq_check "$file" "includes only refs/heads/main" '.conditions.ref_name.include == ["refs/heads/main"]'
  jq_check "$file" "has no excluded refs" '.conditions.ref_name.exclude == []'
}

require_owner_pr_bypass() {
  local file=$1
  jq_check "$file" "has exactly one owner PR-only bypass" '
    (.bypass_actors | length) == 1
    and .bypass_actors[0].actor_type == "User"
    and .bypass_actors[0].bypass_mode == "pull_request"
    and (.bypass_actors[0].actor_id | type) == "number"
  '
  if [[ -n "$OWNER_ID" ]]; then
    jq_check "$file" "bypass actor id matches repository owner" \
      --argjson owner_id "$OWNER_ID" ".bypass_actors[0].actor_id == \$owner_id"
  fi
}

require_rule_types() {
  jq_check "$1" "has exactly the expected rule types" \
    --argjson expected "$2" "([.rules[].type] | sort) == (\$expected | sort)"
}

validate_integrity() {
  local file="$RULESET_DIR/main-integrity.json"
  require_common_ruleset "$file" "Protect main: integrity"
  require_file "$file" || return
  jq_check "$file" "has no bypass actors" '.bypass_actors == []'
  require_rule_types "$file" '["code_scanning","deletion","non_fast_forward","pull_request","required_linear_history","required_status_checks"]'
  jq_check "$file" "pull request rule requires squash-only merges without review semantics" '
    (.rules[] | select(.type == "pull_request") | .parameters)
      | .allowed_merge_methods == ["squash"]
        and .required_approving_review_count == 0
        and .dismiss_stale_reviews_on_push == false
        and .require_code_owner_review == false
        and .require_last_push_approval == false
        and .required_review_thread_resolution == false
  '
  jq_check "$file" "required status checks require only strict GitHub Actions ci" '
    (.rules[] | select(.type == "required_status_checks") | .parameters)
      | .strict_required_status_checks_policy == true
        and .do_not_enforce_on_create == false
        and .required_status_checks == [{"context":"ci","integration_id":15368}]
  '
  jq_check "$file" "CodeQL blocks errors and high-or-higher security alerts" '
    (.rules[] | select(.type == "code_scanning") | .parameters.code_scanning_tools)
      == [{"tool":"CodeQL","alerts_threshold":"errors","security_alerts_threshold":"high_or_higher"}]
  '
}

validate_review() {
  local file="$RULESET_DIR/main-review.json"
  require_common_ruleset "$file" "Protect main: review"
  require_file "$file" || return
  require_owner_pr_bypass "$file"
  require_rule_types "$file" '["pull_request"]'
  jq_check "$file" "review rule requires one code-owner approval, last-push approval, and resolved threads" '
    (.rules[] | select(.type == "pull_request") | .parameters)
      | .required_approving_review_count == 1
        and .dismiss_stale_reviews_on_push == true
        and .require_code_owner_review == true
        and .require_last_push_approval == true
        and .required_review_thread_resolution == true
        and .allowed_merge_methods == ["squash"]
  '
}

validate_owner_updates() {
  local file="$RULESET_DIR/main-owner-updates.json"
  require_common_ruleset "$file" "Protect main: owner updates"
  require_file "$file" || return
  require_owner_pr_bypass "$file"
  require_rule_types "$file" '["update"]'
}

validate_live_repository() {
  local repo=$1 value classic
  value=$(gh api "repos/$repo") || { fail "could not read repository settings"; return; }
  jq_check_value "$value" "repository merge and security settings do not match policy" '
    .allow_merge_commit == false
    and .allow_squash_merge == true
    and .allow_rebase_merge == false
    and .allow_auto_merge == false
    and .delete_branch_on_merge == true
    and .security_and_analysis.secret_scanning.status == "enabled"
    and .security_and_analysis.secret_scanning_push_protection.status == "enabled"
    and .security_and_analysis.dependabot_security_updates.status == "enabled"
  '
  if classic=$(gh api "repos/$repo/branches/main/protection" 2>/dev/null); then
    fail "classic main branch protection overlaps the ruleset source of truth"
  elif [[ $(jq -r '.status // empty' <<<"$classic") != 404 ]]; then
    fail "could not prove classic main branch protection is absent"
  fi
  value=$(gh api "repos/$repo/actions/permissions") || { fail "could not read Actions policy"; return; }
  jq_check_value "$value" "Actions must be enabled, selected, and SHA-pinned" \
    '.enabled == true and .allowed_actions == "selected" and .sha_pinning_required == true'
  value=$(gh api "repos/$repo/actions/permissions/selected-actions") || { fail "could not read selected Actions policy"; return; }
  jq_check_value "$value" "only GitHub-owned Actions must be allowed" \
    '.github_owned_allowed == true and .verified_allowed == false and .patterns_allowed == []'
  value=$(gh api "repos/$repo/actions/permissions/workflow") || { fail "could not read workflow defaults"; return; }
  jq_check_value "$value" "workflow defaults must be read-only, with PR creation enabled for upstream imports" \
    '.default_workflow_permissions == "read" and .can_approve_pull_request_reviews == true'
  value=$(gh api "repos/$repo/immutable-releases") || { fail "could not read immutable-release policy"; return; }
  jq_check_value "$value" "immutable releases must be enabled" '.enabled == true'
  value=$(gh api "repos/$repo/private-vulnerability-reporting") || { fail "could not read private vulnerability reporting"; return; }
  jq_check_value "$value" "private vulnerability reporting must be enabled" '.enabled == true'
  gh api "repos/$repo/vulnerability-alerts" >/dev/null \
    || fail "Dependabot vulnerability alerts must be enabled"
  value=$(gh api "repos/$repo/automated-security-fixes") \
    || { fail "could not read automated security fixes"; return; }
  jq_check_value "$value" "Dependabot automated security fixes must be enabled" '.enabled == true'
  value=$(gh api "repos/$repo/code-scanning/default-setup") || { fail "could not read CodeQL default setup"; return; }
  jq_check_value "$value" "CodeQL default setup must scan Actions and JavaScript/TypeScript weekly with the default query suite" '
    .state == "configured"
    and ((["actions", "javascript-typescript"] - .languages) == [])
    and .query_suite == "default"
    and .schedule == "weekly"
  '
}

if [[ -n "$LIVE_REPO" ]]; then
  fetch_live_rulesets "$LIVE_REPO"
fi
validate_integrity
validate_review
validate_owner_updates
if [[ -n "$LIVE_REPO" ]]; then
  validate_live_repository "$LIVE_REPO"
fi

[[ "$failures" -eq 0 ]] || exit 1
source_label="$RULESET_DIR"
[[ -n "$LIVE_REPO" ]] && source_label="live $LIVE_REPO"
echo "ruleset-check: ok: $source_label satisfies the canonical repository policy."
